DATABASE_URL="postgresql://user:password@localhost:5432/garageapp"
JWT_SECRET="replace-with-a-long-random-secret"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Stripe Dashboard endpoint (test mode while using sk_test_/pk_test_):
# https://garageappbackend-production.up.railway.app/payments/webhook
GOOGLE_WEB_CLIENT_ID="your-google-web-oauth-client-id.apps.googleusercontent.com"
GOOGLE_MAPS_GEOCODING_API_KEY="server-only-google-geocoding-api-key"
# This server-only key must also allow Places API (New) for Home address autocomplete.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-user"
SMTP_PASSWORD="smtp-password"
SMTP_FROM="GarageApp <no-reply@example.com>"
RESEND_API_KEY="re_..."
EMAIL_FROM="GarageApp <no-reply@example.com>"
# Recipient for authenticated support requests. Change this value in Railway
# when support ownership changes; it is never exposed to the mobile client.
SUPPORT_EMAIL_TO="ramiro.mpdev@gmail.com"
EMAIL_VERIFICATION_URL="https://api.example.com/auth/verify-email"
# Required only to allow credits for EUR reservations. Value is USD per EUR
# (for example, obtain it from your approved FX source); leave unset to disable
# credit payments for EUR rather than applying an invented exchange rate.
CREDITS_EUR_TO_USD_RATE=""
